From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Iscle <albertiscle9@gmail.com>
Date: Sat, 14 Nov 2026 22:43:54 +0100
Subject: [PATCH] MiuiCamera: Force the shutter sound only where the law
 requires it

The camera forces the shutter sound, and hides its switch, when the
region or, without ro.miui.region, the language is Japanese or Korean.
Ask the framework instead, which knows from the network whether the
country requires the sound.
---
 smali_classes4/I7/c.smali | 43 ++-------------------------------------
 1 file changed, 2 insertions(+), 41 deletions(-)

diff --git a/smali_classes4/I7/c.smali b/smali_classes4/I7/c.smali
index 5f198bdc..f8b209a0 100644
--- a/smali_classes4/I7/c.smali
+++ b/smali_classes4/I7/c.smali
@@ -4570,51 +4570,12 @@
 .end method
 
 .method public final x()Z
-    .locals 1
-
-    invoke-virtual {p0}, LI7/c;->w()Z
-
-    move-result p0
-
-    if-nez p0, :cond_1
-
-    sget-object p0, Lv6/b;->c0:Ljava/lang/String;
-
-    invoke-static {p0}, Landroid/text/TextUtils;->isEmpty(Ljava/lang/CharSequence;)Z
-
-    move-result p0
-
-    if-nez p0, :cond_0
-
-    sget-object p0, Lv6/b;->c0:Ljava/lang/String;
-
-    goto :goto_0
-
-    :cond_0
-    invoke-static {}, Ljava/util/Locale;->getDefault()Ljava/util/Locale;
-
-    move-result-object p0
-
-    invoke-virtual {p0}, Ljava/util/Locale;->getCountry()Ljava/lang/String;
-
-    move-result-object p0
-
-    :goto_0
-    sget-object v0, Lv6/b;->b0:Ljava/util/List;
+    .locals 0
 
-    invoke-interface {v0, p0}, Ljava/util/List;->contains(Ljava/lang/Object;)Z
+    invoke-static {}, Landroid/media/MediaActionSound;->mustPlayShutterSound()Z
 
     move-result p0
 
-    if-eqz p0, :cond_1
-
-    const/4 p0, 0x1
-
-    return p0
-
-    :cond_1
-    const/4 p0, 0x0
-
     return p0
 .end method
 
