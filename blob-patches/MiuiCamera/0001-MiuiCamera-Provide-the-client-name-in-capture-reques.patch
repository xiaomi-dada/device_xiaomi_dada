From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Iscle <albertiscle9@gmail.com>
Date: Thu, 12 Nov 2026 08:43:38 +0100
Subject: [PATCH] MiuiCamera: Provide the client name in capture requests

HyperOS cameraserver adds the package name of the client to the
default request templates and the session parameters. The camera
provider reads it to tell the Xiaomi camera apart from other apps and
enables its own processing only for it.
---
 smali_classes3/J9/b.smali                     |  2 +
 .../android/camera/compat/ClientName.smali    | 62 +++++++++++++++++++
 .../mivi/qcom/MockCameraImageReceiver.smali   |  2 +
 3 files changed, 66 insertions(+)
 create mode 100644 smali_classes5/com/android/camera/compat/ClientName.smali

diff --git a/smali_classes3/J9/b.smali b/smali_classes3/J9/b.smali
index 3c1fe9c..a790237 100644
--- a/smali_classes3/J9/b.smali
+++ b/smali_classes3/J9/b.smali
@@ -78,6 +78,8 @@
 
     invoke-static {p0, p1}, Lkotlin/jvm/internal/l;->e(Ljava/lang/Object;Ljava/lang/String;)V
 
+    invoke-static {p0}, Lcom/android/camera/compat/ClientName;->apply(Landroid/hardware/camera2/CaptureRequest$Builder;)V
+
     monitor-enter p2
 
     :try_start_0
diff --git a/smali_classes5/com/android/camera/compat/ClientName.smali b/smali_classes5/com/android/camera/compat/ClientName.smali
new file mode 100644
index 0000000..f70774e
--- /dev/null
+++ b/smali_classes5/com/android/camera/compat/ClientName.smali
@@ -0,0 +1,62 @@
+.class public final Lcom/android/camera/compat/ClientName;
+.super Ljava/lang/Object;
+.source "ClientName.java"
+
+
+# HyperOS cameraserver tags every default request and the session
+# parameters with the package name of the client. The camera HAL uses
+# it to tell the Xiaomi camera apart from third party apps.
+
+.field private static final KEY:Landroid/hardware/camera2/CaptureRequest$Key;
+    .annotation system Ldalvik/annotation/Signature;
+        value = {
+            "Landroid/hardware/camera2/CaptureRequest$Key<",
+            "[B>;"
+        }
+    .end annotation
+.end field
+
+.field private static final VALUE:[B
+
+
+.method static constructor <clinit>()V
+    .registers 3
+
+    new-instance v0, Landroid/hardware/camera2/CaptureRequest$Key;
+
+    const-string v1, "com.xiaomi.sessionparams.clientName"
+
+    const-class v2, [B
+
+    invoke-direct {v0, v1, v2}, Landroid/hardware/camera2/CaptureRequest$Key;-><init>(Ljava/lang/String;Ljava/lang/Class;)V
+
+    sput-object v0, Lcom/android/camera/compat/ClientName;->KEY:Landroid/hardware/camera2/CaptureRequest$Key;
+
+    const-string v0, "com.android.camera\u0000"
+
+    sget-object v1, Ljava/nio/charset/StandardCharsets;->UTF_8:Ljava/nio/charset/Charset;
+
+    invoke-virtual {v0, v1}, Ljava/lang/String;->getBytes(Ljava/nio/charset/Charset;)[B
+
+    move-result-object v0
+
+    sput-object v0, Lcom/android/camera/compat/ClientName;->VALUE:[B
+
+    return-void
+.end method
+
+.method public static apply(Landroid/hardware/camera2/CaptureRequest$Builder;)V
+    .registers 3
+
+    :try_start_0
+    sget-object v0, Lcom/android/camera/compat/ClientName;->KEY:Landroid/hardware/camera2/CaptureRequest$Key;
+
+    sget-object v1, Lcom/android/camera/compat/ClientName;->VALUE:[B
+
+    invoke-virtual {p0, v0, v1}, Landroid/hardware/camera2/CaptureRequest$Builder;->set(Landroid/hardware/camera2/CaptureRequest$Key;Ljava/lang/Object;)V
+    :try_end_0
+    .catch Ljava/lang/IllegalArgumentException; {:try_start_0 .. :try_end_0} :catch_0
+
+    :catch_0
+    return-void
+.end method
diff --git a/smali_classes5/com/xiaomi/camera/mivi/qcom/MockCameraImageReceiver.smali b/smali_classes5/com/xiaomi/camera/mivi/qcom/MockCameraImageReceiver.smali
index 6e69c3c..08bb5ae 100644
--- a/smali_classes5/com/xiaomi/camera/mivi/qcom/MockCameraImageReceiver.smali
+++ b/smali_classes5/com/xiaomi/camera/mivi/qcom/MockCameraImageReceiver.smali
@@ -2715,6 +2715,8 @@
 
     move-result-object v2
 
+    invoke-static {v2}, Lcom/android/camera/compat/ClientName;->apply(Landroid/hardware/camera2/CaptureRequest$Builder;)V
+
     iget-object v4, p0, Lcom/xiaomi/camera/mivi/qcom/MockCameraImageReceiver;->mImageReaderList:Ljava/util/List;
 
     invoke-interface {v4}, Ljava/util/List;->iterator()Ljava/util/Iterator;
-- 
2.56.0

