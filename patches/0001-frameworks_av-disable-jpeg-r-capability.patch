From 635101451d9d07a022690760be3c19d038525140 Mon Sep 17 00:00:00 2001
From: karthick-kk <kkzone@gmail.com>
Date: Wed, 20 May 2026 17:35:08 +0530
Subject: [PATCH] camera: Remove DYNAMIC_RANGE_TEN_BIT capability when JPEG_R
 is disabled

When ro.camera.disableJpegR=true is set, remove the DYNAMIC_RANGE_TEN_BIT
capability from camera characteristics. This prevents apps from seeing
JPEG_R as a supported format when the HAL cannot actually handle it.

Some camera HALs advertise 10-bit HDR capability but fail when apps
request JPEG_R streams, causing configureStreams to fail. This fix
ensures the capability is not advertised when JPEG_R support is disabled.
---
 .../common/CameraProviderManager.cpp          | 38 +++++++++++++++++++
 .../common/CameraProviderManager.h            |  1 +
 .../common/aidl/AidlProviderInfo.cpp          |  6 +++
 3 files changed, 45 insertions(+)

diff --git a/services/camera/libcameraservice/common/CameraProviderManager.cpp b/services/camera/libcameraservice/common/CameraProviderManager.cpp
index 7032db04aa..d239d1ca9d 100644
--- a/services/camera/libcameraservice/common/CameraProviderManager.cpp
+++ b/services/camera/libcameraservice/common/CameraProviderManager.cpp
@@ -1808,6 +1808,44 @@ status_t CameraProviderManager::ProviderInfo::DeviceInfo3::fixupManualFlashStren
     return res;
 }
 
+status_t CameraProviderManager::ProviderInfo::DeviceInfo3::removeTenBitDynamicRangeCapability() {
+    // If JPEG_R is disabled via property, remove DYNAMIC_RANGE_TEN_BIT capability
+    // to prevent apps from requesting unsupported JPEG_R streams
+    if (!kFrameworkJpegRDisabled) {
+        return OK;
+    }
+
+    auto& c = mCameraCharacteristics;
+    camera_metadata_entry_t caps = c.find(ANDROID_REQUEST_AVAILABLE_CAPABILITIES);
+    if (caps.count == 0) {
+        return OK;
+    }
+
+    std::vector<uint8_t> newCaps;
+    bool found = false;
+    for (size_t i = 0; i < caps.count; i++) {
+        if (caps.data.u8[i] == ANDROID_REQUEST_AVAILABLE_CAPABILITIES_DYNAMIC_RANGE_TEN_BIT) {
+            found = true;
+            ALOGI("%s: Removing DYNAMIC_RANGE_TEN_BIT capability (ro.camera.disableJpegR=true)",
+                    __FUNCTION__);
+        } else {
+            newCaps.push_back(caps.data.u8[i]);
+        }
+    }
+
+    if (found && !newCaps.empty()) {
+        status_t res = c.update(ANDROID_REQUEST_AVAILABLE_CAPABILITIES,
+                newCaps.data(), newCaps.size());
+        if (res != OK) {
+            ALOGE("%s: Failed to update capabilities: %s (%d)",
+                    __FUNCTION__, strerror(-res), res);
+            return res;
+        }
+    }
+
+    return OK;
+}
+
 status_t CameraProviderManager::ProviderInfo::DeviceInfo3::fixupMonochromeTags() {
     status_t res = OK;
     auto& c = mCameraCharacteristics;
diff --git a/services/camera/libcameraservice/common/CameraProviderManager.h b/services/camera/libcameraservice/common/CameraProviderManager.h
index 40a4254725..459a606bc2 100644
